# Copy this file to .env and fill in your own values. Never commit .env.
# Everything here ends up in the app people download, so only public keys go here.

# Your Supabase project's address and public (anon) key. Never the service key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: spam protection on sign up (Cloudflare Turnstile site key).
VITE_TURNSTILE_SITE_KEY=

# Optional: push notifications (the public VAPID key).
VITE_VAPID_PUBLIC_KEY=

# Optional: set to 1 to turn on the Places preview that is still being built.
VITE_CRN_PREVIEW=
